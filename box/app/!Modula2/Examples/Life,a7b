MODULE Life;
(* Life: Conway's Game of Life in text.  Each generation is drawn in place
   with VDU 31 (move the text cursor) so the board does not scroll.  The
   board wraps round at its edges.  It runs 200 generations; Escape stops
   it sooner.  Runs in a TaskWindow or at the command line. *)
IMPORT SWI;
FROM STextIO IMPORT WriteString, WriteChar, WriteLn;
FROM SWholeIO IMPORT WriteInt;

CONST W = 60; H = 20; Generations = 200;
TYPE Board = ARRAY [0..H-1], [0..W-1] OF BOOLEAN;
VAR now, next: Board; gen, live: INTEGER; r: SWI.Regs; seed: CARDINAL32;

PROCEDURE Vdu(c: CARDINAL); BEGIN r[0] := c; SWI.Call(0, r) END Vdu;
PROCEDURE Home; BEGIN Vdu(30) END Home;      (* VDU 30: the top left *)

PROCEDURE Random(n: CARDINAL32): CARDINAL32;
BEGIN seed := seed * 1103515245 + 12345; RETURN (seed DIV 65536) MOD n END Random;

PROCEDURE Neighbours(row, col: INTEGER): INTEGER;
VAR dr, dc, n: INTEGER;
BEGIN
  n := 0;
  FOR dr := -1 TO 1 DO
    FOR dc := -1 TO 1 DO
      IF ((dr # 0) OR (dc # 0)) AND now[(row + dr + H) MOD H, (col + dc + W) MOD W] THEN INC(n) END
    END
  END;
  RETURN n
END Neighbours;

PROCEDURE Step;
VAR row, col, n: INTEGER;
BEGIN
  live := 0;
  FOR row := 0 TO H - 1 DO
    FOR col := 0 TO W - 1 DO
      n := Neighbours(row, col);
      next[row, col] := (n = 3) OR (now[row, col] AND (n = 2));
      IF next[row, col] THEN INC(live) END
    END
  END;
  now := next
END Step;

PROCEDURE Show;
VAR row, col: INTEGER;
BEGIN
  Home;
  WriteString("Life in Modula-2: generation "); WriteInt(gen, 4);
  WriteString(", "); WriteInt(live, 4); WriteString(" alive   "); WriteLn;
  FOR row := 0 TO H - 1 DO
    FOR col := 0 TO W - 1 DO
      IF now[row, col] THEN WriteChar("#") ELSE WriteChar(".") END
    END;
    WriteLn
  END
END Show;

PROCEDURE Seed;
VAR row, col: INTEGER;
BEGIN
  SWI.CallName("OS_ReadMonotonicTime", r); seed := r[0];
  FOR row := 0 TO H - 1 DO
    FOR col := 0 TO W - 1 DO now[row, col] := Random(4) = 0 END
  END;
  (* and a glider in the top left *)
  now[1, 2] := TRUE; now[2, 3] := TRUE; now[3, 1] := TRUE; now[3, 2] := TRUE; now[3, 3] := TRUE
END Seed;

BEGIN
  Vdu(12);                                    (* clear the screen *)
  Seed;
  gen := 0;
  WHILE gen < Generations DO INC(gen); Step; Show END
END Life.
