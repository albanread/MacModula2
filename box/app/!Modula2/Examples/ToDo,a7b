MODULE ToDo;
(* ToDo: a list on the desktop, by the Declaritive module.  Type a job and
   press Return or Add; select one and press Done to take it off.  A clock
   at the foot is kept by the tick event (every second). *)
IMPORT Declaritive, SWI;
FROM Declaritive IMPORT Event, Is;
FROM SYSTEM IMPORT ADR;
FROM Strings IMPORT Assign, Append, Length;
FROM WholeStr IMPORT IntToStr, StrToInt;
FROM ConvTypes IMPORT ConvResults, strAllRight;

CONST Max = 20;
TYPE Job = ARRAY [0..59] OF CHAR;
VAR jobs: ARRAY [0..Max-1] OF Job; count, chosen: INTEGER;
    w: Declaritive.Window; e: Event; done: BOOLEAN;
    opts: ARRAY [0..2047] OF CHAR;

(* The list's options, set as a property: one a line, "value=text" *)
PROCEDURE Show;
VAR i: INTEGER; n: ARRAY [0..15] OF CHAR; nl: ARRAY [0..0] OF CHAR;
BEGIN
  opts := ""; nl[0] := CHR(10);
  FOR i := 0 TO count - 1 DO
    IntToStr(i, n); Append(n, opts); Append("=", opts); Append(jobs[i], opts); Append(nl, opts)
  END;
  Declaritive.Set(w, "list", "options", opts);
  IF count = 0 THEN Assign("Nothing to do", opts)
  ELSE IntToStr(count, opts); Append(" to do", opts)
  END;
  Declaritive.Set(w, "count", "text", opts);
  chosen := -1
END Show;

PROCEDURE Add(job: ARRAY OF CHAR);
BEGIN
  IF (Length(job) = 0) OR (count = Max) THEN RETURN END;
  Assign(job, jobs[count]); INC(count); Show;
  Declaritive.Set(w, "job", "value", "")
END Add;

PROCEDURE Remove(i: INTEGER);                 (* the jobs after it move up one *)
BEGIN
  IF (i < 0) OR (i >= count) THEN RETURN END;
  WHILE i < count - 1 DO jobs[i] := jobs[i + 1]; INC(i) END;
  DEC(count); Show
END Remove;

PROCEDURE Clock;
VAR r: SWI.Regs; buf: ARRAY [0..63] OF ACHAR; t, s: ARRAY [0..63] OF CHAR;
BEGIN
  r[0] := SWI.Str("Sys$Time"); r[1] := SWI.Addr(ADR(buf)); r[2] := 60; r[3] := 0; r[4] := 3;
  SWI.CallName("OS_ReadVarVal", r);
  buf[r[2]] := 0C; SWI.GetStr(SWI.Addr(ADR(buf)), t);
  Assign("Time now: ", s); Append(t, s);
  Declaritive.Set(w, "clock", "text", s)
END Clock;

VAR job: Declaritive.Text; res: ConvResults;
BEGIN
  Declaritive.Init("ToDo");
  Declaritive.Add("{'type':'window','id':'todo','title':'Modula-2 To do','tick':100,'body':{'type':'stack','children':[");
  Declaritive.Add("{'type':'row','children':[{'type':'input','id':'job','label':'Job','grow':1},");
  Declaritive.Add("{'type':'button','id':'add','text':'Add','default':true}]},");
  Declaritive.Add("{'type':'list-box','id':'list','rows':8,'options':[]},");
  Declaritive.Add("{'type':'row','children':[{'type':'text','id':'count','text':'Nothing to do','grow':1},");
  Declaritive.Add("{'type':'button','id':'done','text':'Done'},{'type':'button','id':'clear','text':'Clear all'}]},");
  Declaritive.Add("{'type':'text','id':'clock','text':''}]}}");
  w := Declaritive.Create();
  count := 0;
  Add("Try Modula-2 on the BOX"); Add("Write a module");
  done := FALSE;
  WHILE NOT done DO
    IF Declaritive.Poll(e) THEN
      CASE e.kind OF
        Declaritive.Click:
          IF Is(e.id, "add") THEN Declaritive.Get(w, "job", "value", job); Add(job)
          ELSIF Is(e.id, "done") THEN Remove(chosen)
          ELSIF Is(e.id, "clear") THEN count := 0; Show
          END
      | Declaritive.Change: IF Is(e.id, "list") THEN StrToInt(e.value, chosen, res) END
      | Declaritive.Submit: Add(e.value)
      | Declaritive.Tick: Clock
      | Declaritive.Close, Declaritive.Quit: done := TRUE
      ELSE
      END
    END
  END;
  Declaritive.CloseDown
END ToDo.
