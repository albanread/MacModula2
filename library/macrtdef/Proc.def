(* Proc — run external programs and write files, for the IDE's build/run.
   The macOS analogue of the Windows build's RunProg. Bodies are provided by the
   NewM2 runtime (src/newm2-runtime/src/proc.rs). *)

DEFINITION MODULE Proc;

FROM SYSTEM IMPORT ADDRESS;

(* Run `cmd` via /bin/sh -c, capturing stdout+stderr into `output`. Returns the
   process exit code (-1 if it could not be started). *)
PROCEDURE RunCapture (cmd: ARRAY OF CHAR; VAR output: ARRAY OF CHAR): INTEGER;

(* Write `content` to `path` (UTF-8). Returns 0 on success, -1 on error. *)
PROCEDURE WriteFile (path: ARRAY OF CHAR; content: ARRAY OF CHAR): INTEGER;

(* Write `len` raw bytes from `data` to `path` (binary — .wav / .mid output).
   Returns 0 on success, -1 on error. *)
PROCEDURE WriteBytes (path: ARRAY OF CHAR; data: ADDRESS; len: CARDINAL): INTEGER;

(* Size of `path` in bytes, or -1 if it can't be read. *)
PROCEDURE FileSize (path: ARRAY OF CHAR): INTEGER;

(* Read up to `max` raw bytes of `path` into `buf` (binary — .wav input).
   Returns the number of bytes read, or -1 on error. *)
PROCEDURE ReadBytes (path: ARRAY OF CHAR; buf: ADDRESS; max: CARDINAL): INTEGER;

(* Read `path` (UTF-8) into `content`. Returns the length, or -1 on error. *)
PROCEDURE ReadFile (path: ARRAY OF CHAR; VAR content: ARRAY OF CHAR): INTEGER;

(* List the entries of directory `path` — subdirectories first, then files, each
   group sorted; hidden (dot) entries skipped — cache them, and return the count
   (-1 if the directory can't be read). Read each name with DirEntry, and use
   IsDir to tell folders from files. *)
PROCEDURE ListDir (path: ARRAY OF CHAR): INTEGER;
PROCEDURE DirEntry (index: INTEGER; VAR name: ARRAY OF CHAR): INTEGER;

(* TRUE if `path` exists and is a directory (so a file browser can offer to
   descend into it rather than open it in an editor tab). *)
PROCEDURE IsDir (path: ARRAY OF CHAR): BOOLEAN;

(* Run the compiler's `complete` command on `path` at (1-based line, 0-based col)
   and capture its `name<TAB>kind<TAB>detail` candidate lines. Returns the count. *)
PROCEDURE Complete (path: ARRAY OF CHAR; line, col: INTEGER;
                    VAR out: ARRAY OF CHAR): INTEGER;

END Proc.
