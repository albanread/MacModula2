(* macOS Objective-C runtime bridge — the native framework-dispatch layer.

   The Windows build reaches frameworks through COM @ordinal vtables; macOS
   reaches AppKit / Foundation / CoreGraphics through Objective-C message sends.
   The three primitives below are provided by the NewM2 runtime
   (src/newm2-runtime/src/objc.rs); there is no IMPLEMENTATION MODULE.

   Message sends go through `objc_msgSend`, whose address `MsgSendPtr` returns.
   Because each selector has its own signature, the caller CASTs that address to
   the matching `Send*` procedure type and calls it indirectly — the exact
   analogue of calling through a COM vtable slot. The first two arguments are
   always (receiver, selector). *)

DEFINITION MODULE ObjC;

FROM SYSTEM IMPORT ADDRESS;

TYPE
  Id    = ADDRESS;   (* an Objective-C object (`id`) *)
  SEL   = ADDRESS;   (* an interned selector        *)
  Class = ADDRESS;   (* a class object              *)

  (* Cocoa geometry value types, laid out to match the C ABI so a [recv sel] that
     returns one is passed in registers correctly (NSRange in x0/x1; NSPoint/NSSize
     in d0/d1; NSRect as a 4-double HFA in d0..d3). The selector database maps a
     struct return kind to these — see docs/design/cocoa-send.md. *)
  NSRange = RECORD location, length: CARDINAL END;
  NSPoint = RECORD x, y: REAL END;
  NSSize  = RECORD width, height: REAL END;
  NSRect  = RECORD origin: NSPoint; size: NSSize END;

  (* objc_msgSend signatures. CAST(MsgSendPtr(), <one of these>) then call. *)
  Send0    = PROCEDURE (Id, SEL): Id;                       (* [obj msg]                 *)
  SendB    = PROCEDURE (Id, SEL, BOOLEAN): Id;              (* [obj msg: aBool]          *)
  SendI    = PROCEDURE (Id, SEL, INTEGER): Id;              (* [obj msg: anInt]          *)
  SendC    = PROCEDURE (Id, SEL, CARDINAL): Id;             (* [obj msg: aUInt]          *)
  SendP    = PROCEDURE (Id, SEL, Id): Id;                   (* [obj msg: anObject]       *)
  SendFrame= PROCEDURE (Id, SEL, REAL, REAL, REAL, REAL): Id; (* [v initWithFrame: rect] *)
  SendF    = PROCEDURE (Id, SEL, REAL): Id;                 (* [obj msg: aFloat]         *)
  Send0I   = PROCEDURE (Id, SEL): INTEGER;                  (* [obj msg] -> NSInteger    *)
  SendPI   = PROCEDURE (Id, SEL, Id): INTEGER;              (* [obj msg: anObject] -> NSInteger *)
  (* [win initWithContentRect: rect styleMask: m backing: b defer: d]
     NSRect (x,y,w,h) flattens to four CGFloat (REAL) registers on arm64. *)
  SendRect = PROCEDURE (Id, SEL, REAL, REAL, REAL, REAL, CARDINAL, CARDINAL, BOOLEAN): Id;

(* objc_getClass / sel_registerName, with the wide M2 name transcoded to a
   UTF-8 C string at the runtime boundary. *)
PROCEDURE GetClass (name: ARRAY OF CHAR): Class;
PROCEDURE Selector (name: ARRAY OF CHAR): SEL;

(* Address of objc_msgSend, for the CAST-and-call idiom above. *)
PROCEDURE MsgSendPtr (): ADDRESS;

(* Build an autoreleased NSString* from a (wide) M2 string. *)
PROCEDURE NSString (s: ARRAY OF CHAR): Id;

(* Copy an NSString's text into a (wide) M2 ARRAY OF CHAR; returns the length. *)
PROCEDURE GetString (nsstr: Id; VAR dest: ARRAY OF CHAR): INTEGER;

(* Manual autorelease pools — the programmer-controlled counterpart to the
   implicit per-run pool. A +0 object (a convenience constructor like NSString,
   or any autoreleased return) is released when the enclosing pool drains. Each
   run is wrapped in a pool already; these bracket an inner scope — typically a
   loop body — so its temporaries drain each iteration, bounding peak memory.

   PushPool/PopPool pair in LIFO order, like Open/Close:

     VAR pool: ObjC.Pool;
     ...
     pool := ObjC.PushPool();
       (* ... +0 temporaries ... *)
     ObjC.PopPool(pool)            (* releases them all *)

   Caveat: an exception between Push and Pop skips the Pop — guard a protected
   block with an EXCEPT arm that calls PopPool then RAISE. *)
TYPE Pool = ADDRESS;              (* an opaque autorelease-pool token *)
PROCEDURE PushPool (): Pool;
PROCEDURE PopPool (p: Pool);

(* Hand a +1 object to the current pool: released at the next PopPool instead of
   an explicit DISPOSE. The dual of DISPOSE — DISPOSE releases now, Autorelease
   releases at the next drain. Returns its argument. *)
PROCEDURE Autorelease (obj: Id): Id;

(* Syntax-color an NSTextView's content using the NewM2 lexer. *)
PROCEDURE Highlight (textview: Id);

(* Mark error lines (parsed from compiler `output`) with a red background in the
   NSTextView; returns how many were marked. *)
PROCEDURE MarkErrors (textview: Id; output: ARRAY OF CHAR): INTEGER;

(* The insertion point as 1-based line / 0-based column, and a setter by offset. *)
PROCEDURE CursorPos (textview: Id; VAR line, col: INTEGER);
PROCEDURE SetCursor (textview: Id; offset: INTEGER);

(* Find the first error/warning line in `output`, select it in `textview` and
   scroll it into view; returns the 1-based line number (0 if none). *)
PROCEDURE GotoFirstError (textview: Id; output: ARRAY OF CHAR): INTEGER;

(* Search the live Obj-C runtime for classes whose name contains `query`
   (case-insensitive); writes `Name : Super` lines into `out`, returns matches. *)
PROCEDURE FindClasses (query: ARRAY OF CHAR; VAR out: ARRAY OF CHAR): INTEGER;

(* Attach a line-number ruler to an editor's NSScrollView. *)
PROCEDURE LineNumbers (scrollview: Id);

(* Run the Core Foundation run loop for `seconds` (a bounded substitute for
   [NSApp run] — shows the window, processes events, then returns). *)
PROCEDURE Pump (seconds: REAL);

(* dlopen a system framework by name (e.g. "AVFoundation") so its classes register
   with the Obj-C runtime and become reachable via GetClass — for frameworks that
   aren't auto-loaded at startup. *)
PROCEDURE LoadFramework (name: ARRAY OF CHAR);

(* Install a minimal Quit menu, activate, and run the AppKit event loop until
   the user quits (blocking) — the real interactive desktop run. *)
PROCEDURE RunApp;

(* Open / Save file dialogs. Return TRUE and fill `path` if the user chose a
   file, FALSE if cancelled. *)
PROCEDURE OpenPanel (VAR path: ARRAY OF CHAR): BOOLEAN;
PROCEDURE SavePanel (VAR path: ARRAY OF CHAR): BOOLEAN;
PROCEDURE OpenFolderPanel (VAR path: ARRAY OF CHAR): BOOLEAN;   (* open project *)

(* Render an NSView (with its subviews) offscreen and write it as a PNG. Works
   without a window server, so a Cocoa UI can be captured to a file. *)
PROCEDURE SnapshotView (view: Id; path: ARRAY OF CHAR): BOOLEAN;

(* Define an Objective-C class at runtime, so UI controls (target/action,
   delegates) can call back into Modula-2. A method's implementation is a
   module-level Modula-2 procedure of type Method1 below, taken as an ADDRESS;
   an Obj-C IMP is just a C function whose first two arguments are the receiver
   and the selector. typeEncoding is the Obj-C signature string, e.g. "v@:@" for
   a void method taking one object argument.
       cls := AllocateClass(GetClass("NSObject"), "MyHandler");
       ok  := AddMethod(cls, Selector("onClick:"), CAST(ADDRESS, OnClick), "v@:@");
       RegisterClass(cls);
*)
TYPE Method1 = PROCEDURE (Id, SEL, Id);   (* IMP for a -(void)foo:(id sender) method *)

PROCEDURE AllocateClass (super: Class; name: ARRAY OF CHAR): Class;
PROCEDURE AddMethod (cls: Class; sel: SEL; imp: ADDRESS; typeEncoding: ARRAY OF CHAR): BOOLEAN;
PROCEDURE RegisterClass (cls: Class);

(* --- Obj-C block literals ------------------------------------------------- *)
(* Wrap an M2 procedure as a Cocoa block, so it can be passed to any API taking
   a block (comparators, enumerate…UsingBlock:, completion handlers, timers).
   The procedure must use the block invoke ABI: its FIRST parameter is the block
   itself (an Id, usually ignored), followed by the block's real parameters:

       PROCEDURE Cmp (blk, a, b: Id): INTEGER;   (* an NSComparator *)
       ...
       sorted := [arr sortedArrayUsingComparator: ObjC.MakeBlock(CAST(ADDRESS, Cmp))];

   The block is global (capture-free): it lives for the program's lifetime. *)
PROCEDURE MakeBlock (invoke: ADDRESS): Id;

END ObjC.
